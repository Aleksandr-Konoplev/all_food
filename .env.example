# Django-key
SECRET_KEY=

# Режим дебага (разработки)
DEBUG=True

# Настройки для подключения к БД
POSTGRES_DB=all_food
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
HOST=
PORT=5432

# Настройки основного почтового клиента
