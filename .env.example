EMAIL_PORT_MAIN=465
EMAIL_USE_TLS_MAIN=False
EMAIL_USE_SSL_MAIN=True
EMAIL_HOST_USER_MAIN=
EMAIL_HOST_PASSWORD_MAIN=

# Настройки почтового клиента отправки рассылок
